# Stripe
PAYMENT_PROVIDER=lemonsqueezy        # lemonsqueezy (default) or stripe
LEMONSQUEEZY_API_KEY=...             # test-mode keys and webhooks are separate from live ones
LEMONSQUEEZY_STORE_ID=...
LEMONSQUEEZY_WEBHOOK_SECRET=...
STRIPE_SECRET_KEY=sk_live_...        # from Stripe dashboard → API keys
STRIPE_WEBHOOK_SECRET=whsec_...      # from Stripe dashboard → Webhooks
STRIPE_PRICE_MONTHLY=price_...       # fallback until a super admin chooses prices at /admin/membership
STRIPE_PRICE_ANNUAL=price_...        # fallback until a super admin chooses prices at /admin/membership
APP_URL=https://your-replit-app.repl.co   # your deployed frontend URL
